// Prisma schema for the Personal Wallet Management application.
// Docs: https://pris.ly/d/prisma-schema
//
// The datasource URL is supplied by prisma7.config.ts (Prisma 7 reads it from
// the config file rather than from this schema) and resolves to DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Whether money moved into the wallet (INCOME) or out of it (EXPENSE).
enum TransactionType {
  INCOME
  EXPENSE
}

/// Which way an unsettled debt points.
enum DebtDirection {
  /// Money lent out: they owe you. Cash has left the wallet.
  RECEIVABLE
  /// Money borrowed: you owe them. Cash has entered the wallet.
  PAYABLE
}

/// An account holder. `clerkId` is the external identity; every other table
/// hangs off the local `id` so the app never depends on the auth vendor's
/// identifiers reaching the database layer.
model User {
  id        String   @id @default(uuid())
  clerkId   String   @unique
  email     String?
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
  categories   Category[]
  debts        Debt[]

  @@map("users")
}

/// A single movement of money in or out of the wallet.
model Transaction {
  id        String          @id @default(uuid())
  type      TransactionType
  /// Always stored as a positive magnitude; `type` carries the direction.
  /// Decimal(12,2) keeps money exact — floats cannot represent 0.10 precisely.
  amount    Decimal         @db.Decimal(12, 2)
  /// Denormalised category name, kept on the row so a transaction stays
  /// readable even if the Category catalog entry is later removed.
  category  String
  note      String?
  date      DateTime
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  /// Owning account. Cascades so closing an account removes its ledger.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Optional link to the Category catalog. Set to NULL rather than cascading
  /// so deleting a category never destroys financial history.
  categoryId  String?
  categoryRef Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  /// Every index leads with userId: the tenant filter is present on all
  /// queries, and an index that does not lead with it cannot serve them.
  @@index([userId, date])
  @@index([userId, type])
  @@index([userId, category])
  @@index([userId, type, date])
  @@map("transactions")
}

/// Catalog of reusable category names, used for grouping and for the
/// category picker in the dashboard UI.
model Category {
  id        String           @id @default(uuid())
  /// Unique per account, not globally — two people may both keep "Groceries".
  name      String
  /// Restricts the category to one side of the ledger; NULL means it can be
  /// used for both income and expenses.
  type      TransactionType?
  /// Hex colour used by the dashboard charts and badges.
  color     String?
  icon      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  /// Owning account. Cascades so closing an account removes its catalog.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[]

  @@unique([userId, name])
  @@index([userId, type])
  @@map("categories")
}

/// Money lent to or borrowed from someone.
///
/// Deliberately not a Transaction: lending is not an expense, it converts cash
/// into a claim. Keeping the two apart leaves income and expense totals
/// meaning what they say, while the balance still reflects real cash — see
/// getWalletSummary, which subtracts what you are owed and adds what you owe.
model Debt {
  id           String        @id @default(uuid())
  direction    DebtDirection
  /// The other party. A free-text name, not a linked account — this is a
  /// personal wallet, and the counterparty is rarely a user of the system.
  counterparty String
  /// The original amount, never mutated. What remains is this minus the
  /// repayments, so the history stays auditable rather than being overwritten.
  principal    Decimal       @db.Decimal(12, 2)
  note         String?
  date         DateTime
  /// Set when repayments have covered the principal. Denormalised so the
  /// common "what is still outstanding" query does not have to aggregate.
  settledAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  repayments DebtRepayment[]

  @@index([userId, direction, settledAt])
  @@index([userId, date])
  @@map("debts")
}

/// A part payment against a debt. Repaying in instalments is the normal case,
/// so this is a ledger of its own rather than a flag on Debt.
model DebtRepayment {
  id        String   @id @default(uuid())
  amount    Decimal  @db.Decimal(12, 2)
  date      DateTime
  note      String?
  createdAt DateTime @default(now())

  debtId String
  debt   Debt   @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@index([debtId, date])
  @@map("debt_repayments")
}
