# ---------------------------------------------------------------------------
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
#
# Local:  copy this file to .env.local and point it at your local Postgres.
# Vercel: set DATABASE_URL in Project Settings -> Environment Variables.
#         Use Neon's POOLED connection string (it contains "-pooler") —
#         serverless functions open a connection per invocation and will
#         exhaust a direct connection limit under any real traffic.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# --- Natural-language search (optional) -------------------------------------
# Powers the dashboard "Ask" bar and POST /api/wallet/ask. Everything else —
# the MCP tools, the REST routes, the rest of the dashboard — works without it.
# Set ONE. If both are present, Groq wins unless ASK_PROVIDER says otherwise.

# Groq — https://console.groq.com/keys
GROQ_API_KEY=""

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# Force a provider: "groq" or "anthropic". Unset auto-detects.
ASK_PROVIDER=""

# Override the model. Defaults: openai/gpt-oss-120b (groq), claude-opus-5 (anthropic).
ASK_MODEL=""

# --- Neon / pooled databases only -------------------------------------------
# Unpooled connection string, used ONLY for `prisma migrate`. A pooler in
# transaction mode cannot run migration DDL. Leave unset for a direct Postgres.
DIRECT_URL=""
